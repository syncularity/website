{
  "name": "syncularity-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:merge-gate && npm run build && npm run test:browser",
    "test:browser": "playwright test",
    "test:merge-gate": "python3 -m unittest discover -s tests -p test_merge_verification.py"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~7.0.2"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.28"
  }
}
